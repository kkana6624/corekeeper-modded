# ===== Core Keeper dedicated server env example =====

# 所有者(ホスト側UID/GIDに合わせる)
PUID=1000
PGID=1000

# ワールド設定
WORLD_INDEX=0
WORLD_NAME=Core Keeper Server
WORLD_SEED=
WORLD_MODE=0
# GAME_ID を固定したい場合のみ
GAME_ID=
# 既存の Game ID (ServerConfig.json) を破棄して毎回新規発行する場合は true に設定
DISCARD_GAME_ID=false

# データパス(通常は変更不要)
DATA_PATH=/home/steam/core-keeper-data

# 接続関連
MAX_PLAYERS=10

# SDR(デフォルト): SERVER_PORT を空にする(ポート開放不要)
SERVER_PORT=

# Direct Connection を使う場合:
# SERVER_PORT=27015
# PASSWORD=yourpassword
# SERVER_IP=0.0.0.0
PASSWORD=
SERVER_IP=

# SteamCMDの追加引数(例: ベータ利用など)が必要なら設定
# 例: STEAMCMD_UPDATE_ARGS= -beta experimental -betapassword xxxx
STEAMCMD_UPDATE_ARGS=

# ===== BepInEx (Linux/macOS: `nix`アーカイブ) =====
# 公式手順: アーカイブ展開 → run_bepinex.sh の executable_name を設定 → run_bepinex.sh で起動
# この構成では server バイナリ本体は永続化しません。
# BepInEx の plugins/config/patchers は `./server-data/bepinex/` に永続化され、起動時にゲームルートへ symlink されます。
BEPINEX_ENABLED=false

# ダウンロードするBepInExリリース（例: 5.4.23.4）
# ※ v5.4.23.2+ 以降は Unix ビルドが linux_x64 等に分割されています。
# ※ バージョンによってアセット名が異なるため、うまく落ちない場合は BEPINEX_ZIP_URL を指定してください。
BEPINEX_RELEASE=5.4.23.4

# 直接URLを指定したい場合（優先）
# 例(旧): https://github.com/BepInEx/BepInEx/releases/download/v5.4.21/BepInEx_unix_5.4.21.0.zip
# 例(新): https://github.com/BepInEx/BepInEx/releases/download/v5.4.23.4/BepInEx_linux_x64_5.4.23.4.zip
BEPINEX_ZIP_URL=

# ===== Discord Notification =====
# Discord Webhook URL を設定すると、サーバー起動・停止時などに通知を送ります
DISCORD_WEBHOOK_URL=


